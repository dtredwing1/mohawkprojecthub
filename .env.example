# --- Next.js & App Server ---
PORT=3000
NODE_ENV=development

# --- Google OAuth (NextAuth.js) ---
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=generate-a-secure-random-secret-in-production

GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Allowed Team Accounts (comma separated, leave blank for open internal testing)
ALLOWED_EMAILS=
ALLOWED_DOMAINS=

# --- Google Cloud Platform (Cloud Run & Firestore) ---
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
# Optional local Firestore emulator:
# FIRESTORE_EMULATOR_HOST=localhost:8080

# --- Google Drive Integration ---
# Optional: Google Cloud Service Account credentials for server-side AI agent Drive operations
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account-key.json

# --- Slack Webhook Notifications ---
# Set to receive real-time notifications on open items, ADRs, and agent deliverables
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/your/webhook/url

# --- Agentic AI Partner API Security ---
# Secret API Key required in 'x-api-key' or 'Authorization: Bearer <token>'
AGENT_API_KEY=hub-agent-dev-key-12345
